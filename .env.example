# ==============================================================================
# ResearchMate — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit .env or real credentials into version control.
# ==============================================================================

# --- Google Gemini Orchestrator (Phase 10 & Multi-Model Fallback) ---
# Get an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=replace_with_your_api_key
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# Legacy single-model fallback if GEMINI_PRIMARY_MODEL is omitted:
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_TEMPERATURE=0.2
GEMINI_MODEL_RETRY_ATTEMPTS=1
GEMINI_MODEL_RETRY_DELAY=0.5

# --- Google Gemini Sub-Agents with Multi-Model Fallback (Research & Task Agents — DEC-033) ---
# Agents share GOOGLE_API_KEY with the orchestrator.
AGENT_GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
AGENT_GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
# Legacy single-model fallback if AGENT_GEMINI_PRIMARY_MODEL is omitted:
# AGENT_GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_GEMINI_TIMEOUT_SECONDS=60.0
AGENT_GEMINI_TEMPERATURE=0.1
AGENT_GEMINI_MODEL_RETRY_ATTEMPTS=1
AGENT_GEMINI_MODEL_RETRY_DELAY=0.5

# --- PostgreSQL Database (Phases 2-6) ---
# SQLAlchemy Psycopg connection string
DATABASE_URL=postgresql+psycopg://postgres:replace_with_your_password@localhost:5432/mas_database
DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Server-Side MCP Configuration (Phases 3-7) ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_STREAMABLE_PATH=/mcp
WORKSPACE_ROOT=workspace
MAX_FILE_SIZE_BYTES=10485760
MAX_NOTE_VERSIONS=0

# --- Client-Side MCP Host Configuration (Phase 8) ---
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_CLIENT_TIMEOUT_SECONDS=30.0
MCP_CLIENT_MAX_RETRIES=3

# --- MAS Orchestrator Limits & Execution (Phases 10-11) ---
ORCHESTRATOR_MAX_STEPS=5
ORCHESTRATOR_AGENT_TIMEOUT=120.0
AGENT_MAX_ITERATIONS=10

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
