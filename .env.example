# ==============================================================================
# ResearchMate — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit .env or real credentials into version control.
# ==============================================================================

# --- Google Gemini Orchestrator (Phase 10) ---
# Get an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_TEMPERATURE=0.2

# --- Local Ollama AI Agents (Phase 9) ---
# Ensure Ollama is running (ollama serve) with llama3.2:3b pulled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=5m

# --- PostgreSQL Database (Phases 2-6) ---
# SQLAlchemy Psycopg connection string
DATABASE_URL=postgresql+psycopg://postgres:replace_with_your_password@localhost:5432/mas_database
DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Server-Side MCP Configuration (Phases 3-7) ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_STREAMABLE_PATH=/mcp
WORKSPACE_ROOT=workspace
MAX_FILE_SIZE_BYTES=10485760
MAX_NOTE_VERSIONS=0

# --- Client-Side MCP Host Configuration (Phase 8) ---
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_CLIENT_TIMEOUT_SECONDS=30.0
MCP_CLIENT_MAX_RETRIES=3

# --- MAS Orchestrator Limits & Execution (Phases 10-11) ---
ORCHESTRATOR_MAX_STEPS=5
ORCHESTRATOR_AGENT_TIMEOUT=120.0
AGENT_MAX_ITERATIONS=10

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
